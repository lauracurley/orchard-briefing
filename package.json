{
  "name": "orchard-briefing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts playwright.config.ts",
    "format:check": "prettier --check src tests scripts playwright.config.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.18.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@neondatabase/serverless": "^1.0.0",
    "graphql": "^16.11.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  }
}
